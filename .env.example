# Copy to .env for local docker-compose testing. .env is gitignored — never commit real values.

# Required to enable the AI Exploration bonus feature. Without it, Task Detail
# shows an "AI unavailable" state but core analytics (Dashboard, task data,
# department totals, Top 3) work fine.
AI_API_KEY=

# Optional overrides — see app/ai_service.py and docs/ADR.md (ADR-005) for defaults
# and why OpenRouter is used as a time-boxed stand-in for the company's own endpoint.
AI_ENDPOINT_URL=
AI_MODEL=
